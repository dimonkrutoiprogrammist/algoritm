алг Сумма_чисел
нач
цел n, count, a
ввод n
count := 1
a := 0
нц пока count <= n
a := a + count
count := count + 1
кц
вывод "Сумма всех чисел от 1 до ", n, " = ", a
кон


алг Факториал
нач
цел n, fact, i
ввод n
fact := 1
нц для i от 1 до n
fact := fact * i
кц
вывод "Факториал числа ", n, " = ", fact
кон

алг Звёздочки
нач
цел n, i
ввод n

|  Квадрат
нц для i от 1 до n
вывод "* ", n
кц

|  Прямоугольный треугольник
нц для i от 1 до n
вывод "* ", i
кц

|  Перевёрнутый треугольник
нц для i от n до 1 шаг -1
вывод "* ", i
кц

| Ромб
нц для i от 1 до n
вывод " ", (n - i), "*", (2 * i - 1)
кц
нц для i от n до 1 шаг -1
вывод " ", (n - i), "*", (2 * i - 1)
кц
кон

алг Среднее
нач
цел count, i, n
вещ number
ввод count
number := 0
нц для i от 1 до count
ввод n
number := number + n
кц
вывод "Среднее ", count, " чисел = ", number / count
кон

алг Количество_цифр
нач
вещ n, count
ввод n
count := 0
нц пока n > 0
count := count + 1
n := n / 10
кц
вывод "Кол-во цифр = ", count
кон

алг Фибоначчи
нач
цел n, a, b, i, temp
ввод n
a := 0
b := 1
нц для i от 1 до n
вывод a
temp := a
a := b
b := temp + b
кц
кон




