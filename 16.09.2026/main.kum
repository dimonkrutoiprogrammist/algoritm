алг первое
нач
цел a,b
вывод "Введите первое число: "
ввод a
вывод "Введите второе число: "
ввод b

выбор
при a > b:
вывод a, " больше ", b
при b > a:
вывод b, " больше ", a
при a = b:
вывод "Числа равные"
иначе
вывод "Неккоректный ввод"
все 
кон

алг второе
нач
вещ a,b,c
вывод "Введите a: "
ввод a
вывод "Введите b: "
ввод b
вывод "Введите c: "
ввод c

вещ d, x_1, x_2, x

d := b ** 2 - 4 * a * c

выбор
при d > 0:
x_1 := (-b + sqrt(d)) / (2 * a)
x_2 := (-b - sqrt(d)) / (2 * a)
вывод "x_1 = ", x_1, ", x_2 = ", x_2
при d = 0:
x := (-b) / (2 * a)
вывод "x = ", x
при d < 0:
вывод "Решения нету" 
все 
кон

алг Три
нач
вещ year
вывод "Введите год: "
ввод year

выбор
при year mod 4 = 0 и (year mod 100 <> 0 или year mod 400 = 0):
вывод "Високосный"
иначе
вывод "Не високосный"
все
кон

алг Четыре
нач
цел n
вывод "Введите номер месяца: "
ввод n
выбор
при n = 1:
вывод "Январь, 31"
при n = 2:
вывод "Февраль, 28"
при n = 3:
вывод "Март, 31"
при n = 4:
вывод "Апрель, 30"
при n = 5:
вывод "Май, 31"
при n = 6:
вывод "Июнь, 30"
при n = 7:
вывод "Июль, 31"
при n = 8:
вывод "Август, 31"
при n = 9:
вывод "Сентябрь, 30"
при n = 10:
вывод "Октябрь, 31"
при n = 11:
вывод "Ноябрь, 30"
при n = 12:
вывод "Декабрь, 31"
все
кон

алг Пять
нач
цел x, y, a
вывод "Введите x: "
ввод x
вывод "Введите y: "
ввод y
вывод "Выберите действие: 1.+   2.-   3.*   4./: "
ввод a
выбор
при a = 1:
вывод x, " + ", y, " = ", x + y
при a = 2:
вывод x, " - ", y, " = ", x - y
при a = 3:
вывод x, " * ", y, " = ", x * y
при a = 4:
вывод x, " / ", y, " = ", x / y
иначе
вывод "Неккоректный ввод"
все
кон

алг Шесть
нач
цел sum 
вывод "Введите сумму стоимости: "
ввод sum
выбор
при sum > 1000:
вывод "Итоговая сумма: ", sum + (sum * 0.9)
при sum > 500:
вывод "Итоговая сумма: ", sum + (sum * 0.8)
иначе
вывод "Итоговая сумма: ", sum 
все
кон

алг Семь 
нач
цел x, y
вывод "Введите x: "
ввод x
вывод "Введите y: "
ввод y
выбор
при x > 0 и y > 0:
вывод "1 четверть"
при x < 0 и y > 0:
вывод "2 четверть"
при x < 0 и y < 0:
вывод "3 четверть"
при x > 0 и y < 0:
вывод "4 четверть"
иначе 
вывод "Неккоректный ввод"
все
кон

алг Восемь
нач
цел sum, times
вывод "Введите сумму вклада: "
ввод sum
вывод "Введите срок в вкладах: "
ввод times
выбор
при times < 6:
вывод "Итоговая сумма: ", sum + (sum * 0.05)
при times >= 6 и times < 12:
вывод "Итоговая сумма: ", sum + (sum * 0.07)
при times >= 12:
вывод "Итоговая сумма: ", sum + (sum * 0.1)
все
кон





