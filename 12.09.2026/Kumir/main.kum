--- 19
алг первое
нач
	вещ a, b, x
	a := 0.1
	b := 2.4
	x := -0.3
	
	вещ a_1, a_2, y
	a_1 := (a * x - sqrt(b)) / (5.7 * (x ** 2 + b ** 2))
	a_2 := ((abs(x + b) - a ** 2.0) / (x ** 2.0)) * (tg(b) ** 2.0)
	y := a_1 - a_2
	
	вывод y
кон

--- 20
алг первое
нач
	вещ a, c, d, x
	a := 4.5
	c := 7.4
	d := -2.1
	x := 0.15
	
	вещ a_1, a_2, a_3, y
	a_1 := sqrt((c - (d * x ** 2)) / x)
	a_2 := lg(x ** 2 + c) / ((0.7 * x) + (a * d))
	a_3 := (10 ** -2) / (c - (d * x ** 3))
	y := a_1 + a_2 - a_3
	
	вывод y
кон
