Вершина := -1

PUSH(x):
    если Вершина = 49:
        вывести "Стек переполнен"
    иначе:
        Вершина := Вершина + 1
        A[Вершина] := x

POP():
    если Вершина = -1:
        вывести "Стек пуст"
    иначе:
        x := A[Вершина]
        Вершина := Вершина - 1
        вернуть x

TOP():
    если Вершина = -1:
        вывести "Стек пуст"
    иначе:
        вернуть A[Вершина]

ISEMPTY():
    вернуть Вершина = -1