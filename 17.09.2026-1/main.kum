алг Вариант_1
нач
вещ x0, xk, dx, a, b, c, x, y
x0 := -1.5
xk := 3.5
dx := 0.5
a := -1.25
b := -1.5
c := 0.75
x := x0
нц пока x <= xk + dx / 2
если x <= 0 то
вывод "x = ", x, ", y = ?"
иначе
y := (0.01 * b * c) / x + cos(sqrt((a ** 3) * x))
вывод "x = ", x, ", y = ", y
все
x := x + dx
кц
кон

алг Вариант_2
нач
вещ x0, xk, dx, a, b, x, y
x0 := 5.3
xk := 10.3
dx := 0.25
a := 1.35
b := -6.25
x := x0
нц пока x <= xk + dx / 2
если x <= 0 то
вывод "x = ", x, " y = ?"
иначе
y := a * x**3 + (cos(x**3 - b))**2
вывод "x = ", x, ", y = ", y
все
x := x + dx
кц
кон

алг Вариант_3
нач
вещ x0, xk, dx, x, y
x0 := -0.75
xk := -2.05
dx := -0.2
x := x0
нц пока x >= xk + dx / 2
если x <= 0 то
вывод "x = ", x, " y = ?"
иначе
y := (9 * (x**4)) + sin(57.2 + x)
вывод "x = ", x, ", y = ", y
все
x := x + dx
кц
кон

алг Вариант_4
нач
вещ x0, xk, dx, b, x, y
x0 := -0.73
xk := -1.73
dx := -0.1
b := -2
x := x0
нц пока x >= xk + dx / 2
если x <= 0 то
вывод "x = ", x, " y = ?"
иначе
y := sqrt(ln(x - b)) / ((b**3 - x**3)**1.5) + ln(x - b)
вывод "x = ", x, ", y = ", y
все
x := x + dx
кц
кон

алг Вариант_5
нач
вещ x0, xk, dx, b, x, y
x0 := 1.23
xk := -2.4
dx := -0.3
b := 12.6
x := x0
нц пока x >= xk + dx / 2
если x <= 0 то
вывод "x = ", x, " y = ?"
иначе
y := 15.28 * (abs(x) ^ -1.5) + cos(ln(abs(x)) + b)
вывод "x = ", x, ", y = ", y
все
x := x + dx
кц
кон

